{
  "manifest_version": 3,
  "name": "DOM-Unshackle",
  "short_name": "DOM-Unshackle",
  "version": "1.1.0",
  "description": "Production-grade Firefox extension (Manifest V3) that neutralizes pseudo-paywalls, scroll locks, event hijacking, and CSS blur filters.",
  "browser_specific_settings": {
    "gecko": {
      "id": "dom-unshackle@unshackle.addon",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "DOM-Unshackle Settings & Control",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/inject-styles.js",
        "src/heuristics.js",
        "src/event-unhijack.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
